// SKYNET TF2 MGE: este arquivo vira o server.cfg a cada inicio, com os valores das variaveis de ambiente.
// Nao coloque senhas aqui: use as variaveis (veja o README).
log on

rcon_password "${RCON_PASSWORD}"
hostname "${SERVER_HOSTNAME}"
sv_password "${SERVER_PASSWORD}"
sv_contact ""
sv_tags "${SERVER_TAGS}"
sv_region ${SERVER_REGION}

// FastDL vazio por padrao: o mapa baixa direto do servidor (mais lento). Veja o README para usar o seu.
sv_downloadurl "${DOWNLOAD_URL}"
sv_allowdownload 1
sv_allowupload 0

// Seguranca: so mapas oficiais podem mandar comandos para o console do servidor
sv_allow_point_servercommand "official"

// Sem SourceTV: todas as vagas sao de jogadores
tv_enable 0

// MGE: o MGEMod cuida das arenas, dos times e das classes. O mapa nunca troca sozinho.
mapcyclefile "mapcycle.txt"
mp_timelimit 0
mp_maxrounds 0
mp_winlimit 0

// Duelo justo: sem critico aleatorio
tf_weapon_criticals 0

// Rates para 100 tick (a imagem ja liga com TICKRATE=100)
sv_maxrate 0
sv_minupdaterate 66
sv_maxupdaterate 100
sv_mincmdrate 66
sv_maxcmdrate 100

sv_quota_stringcmdspersecond 400
